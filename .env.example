# ─── Privy ───────────────────────────────────────────────────────────────────
# Get from https://console.privy.io → your app → Settings
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-side only — NEVER prefix with NEXT_PUBLIC_
PRIVY_APP_SECRET=

# ─── RPC ─────────────────────────────────────────────────────────────────────
# Alchemy API key — powers Base mainnet RPC (Velvet) and Solana mainnet RPC (Flash Trade)
# Get from https://dashboard.alchemy.com → create apps on Base Mainnet + Solana Mainnet
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Flash Trade — dedicated Solana mainnet RPC (optional, falls back to Alchemy key above)
# Recommended for production: https://www.helius.dev or https://www.quicknode.com
FLASH_SOLANA_RPC=

# Flash Trade — MagicBlock ER endpoint for perpetuals (optional)
# Defaults to https://flash.magicblock.xyz — only override if you have a private endpoint
# FLASH_ER_RPC=https://flash.magicblock.xyz

# ─── Database ────────────────────────────────────────────────────────────────
# Get from https://neon.tech → create project → connection string
DATABASE_URL=

# ─── AI ──────────────────────────────────────────────────────────────────────
# AI_PROVIDER controls which LLM powers the chat.
# Values: "openai" (default) | "qwen"
# Voice transcription always uses OpenAI Whisper regardless of this setting.
AI_PROVIDER=openai

# Google Gemini — powers activity narration + weekly spending insights
# Get from https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=
# Optional: override the default chat model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Qwen Cloud — https://dashscope.aliyuncs.com (set AI_PROVIDER=qwen to activate)
# Get API key from https://bailian.console.aliyun.com → API Keys
QWEN_API_KEY=
# Optional: override the default Qwen model (default: qwen-plus)
# Available: qwen-turbo | qwen-plus | qwen-max | qwen3-7b
# QWEN_MODEL=qwen-plus

# ─── Circle Gateway Nanopayments (Base mainnet) ──────────────────────────────
#
# CIRCLE_BUYER_PRIVATE_KEY
#   Private key of the agent's EOA wallet used to make gas-free nanopayments
#   server-side. NEVER prefix with NEXT_PUBLIC_.
#   Steps:
#     1. Create a new dedicated wallet (MetaMask → Add account → Create account)
#     2. Export private key (Account details → Show private key)
#     3. Fund it with Base mainnet USDC (bridge from any chain or buy on exchange)
CIRCLE_BUYER_PRIVATE_KEY=

# CIRCLE_SELLER_ADDRESS
#   EVM address that receives payments via the x402 /api/nanopay/sell endpoint.
#   Can be any wallet address you control.
CIRCLE_SELLER_ADDRESS=

# Optional overrides (leave blank to use defaults)
# CIRCLE_USDC_ADDRESS=       # Default: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 (Base mainnet USDC)
# CIRCLE_GATEWAY_WALLET_ADDRESS=  # Default: fetched from Circle facilitator

# ─── Solana Nanopayments ─────────────────────────────────────────────────────
# Private key of the agent's Solana wallet for x402/MPP nanopayments on Solana mainnet.
# NEVER prefix with NEXT_PUBLIC_. Keep this separate from any user-facing wallet.
# Generate: node -e "const k=require('@solana/web3.js').Keypair.generate(); console.log(Buffer.from(k.secretKey).toString('base58'))"
SOLANA_AGENT_PRIVATE_KEY=

# Solana seller wallet for /api/solpay/sell (MPP gated endpoint).
# Defaults to SOLANA_AGENT_PRIVATE_KEY when not set (demo only — use a dedicated key in production).
SOLANA_SELLER_PRIVATE_KEY=

# MPP challenge-binding secret — random 32+ byte hex or UUID string.
# MUST be stable across restarts; without it every server restart invalidates outstanding challenges.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAY_KIT_MPP_SECRET=

# Anti-replay store for MPP challenges (prevents double-spend of a payment proof).
# Store.memory()     — default, single-instance, lost on restart (dev only)
# Store.redis()      — multi-instance Node.js (set REDIS_URL)
# Store.upstash()    — serverless (set UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN)
# Store.cloudflare() — Cloudflare Workers KV (pass KV namespace binding in getSolPayKit)
# REDIS_URL=redis://...
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: Solana address that receives the $0.001 platform fee on /api/solpay/sell-with-fee.
# Must be a DIFFERENT address from SOLANA_SELLER_PRIVATE_KEY's public key.
# If not set, the sell-with-fee endpoint returns 500.
SOLANA_FEE_RECIPIENT=
# Solana address that receives USDC when users pay bills or buy investments via the Solana network.
# Set this to your app's treasury / custodial wallet on Solana mainnet.
# Must be NEXT_PUBLIC_ so the Arc AppKit Solana adapter can use it client-side.
# Without this, the Solana payment path in the UI will throw "Solana receiver not configured".
NEXT_PUBLIC_SOLANA_BILL_RECEIVER=

# ─── Credible Finance (Banking) ──────────────────────────────────────────────
# Contact Credible Finance representative to get your API credentials.
# Also share your server IP for whitelisting and your webhook endpoint.
#
# Webhook endpoint to register with Credible:  https://<your-domain>/api/banking/webhook
# Base URL is fixed — do not override unless Credible provides a sandbox URL
# CREDIBLE_FINANCE_BASE_URL=https://api.credible.finance/collections/api
CREDIBLE_FINANCE_API_KEY=
CREDIBLE_FINANCE_API_SECRET=

# ─── App URL ─────────────────────────────────────────────────────────────────
# Used by AI tools to call internal API routes (nanopay/*, etc.)
# ⚠️  MUST be updated before deploying to production — localhost will break server-side fetches.
# Set to your Vercel deployment URL, e.g. https://bottie.finance
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ─── Sana Bot ────────────────────────────────────────────────────────────────
# Get from https://sana.bot/gateway/app/api-keys (default scope read:all)
SANABOT_API_KEY=

# ─── Oro GRAIL Gold Trading ───────────────────────────────────────────────────
# Contact Oro / GRAIL onboarding to receive your partner credentials.
# GRAIL_PARTNER_ID is the UUID assigned to your integration.
# GRAIL_PARTNER_PRIVATE_KEY is a base58 Solana keypair that ORO has whitelisted on-chain
#   to co-sign gold trade transactions (server-only — never expose to the browser).
# GRAIL_API_KEY is obtained via the challenge-response flow (POST /v1/auth/challenge → sign → POST /v1/auth/api-key)
#   and is formatted as grail_partner_<hex> (server-only — never prefix with NEXT_PUBLIC_).
GRAIL_PARTNER_ID=
GRAIL_PARTNER_PRIVATE_KEY=
GRAIL_API_KEY=

# ── Roaster (AI Rap Battles on Solana) ────────────────────────────────────────
# ROASTER_API_BASE: Roaster API base URL (server-only)
# ROASTER_API_KEY: API key from Roaster developer dashboard (server-only — never prefix with NEXT_PUBLIC_)
ROASTER_API_BASE=https://api.roaster.gg
ROASTER_API_KEY=

# Nosana GPU Cloud — decentralized GPU compute on Solana
# NOSANA_API_KEY: Bearer token from Nosana dashboard (nos_xxx_...) — server-only — NEVER prefix with NEXT_PUBLIC_
# NOSANA_API_BASE: override if using a staging/self-hosted API (optional)
NOSANA_API_BASE=https://dashboard.k8s.prd.nos.ci/api
NOSANA_API_KEY=

# ── SpherePay ──────────────────────────────────────────────────────────────────
# SPHEREPAY_API_KEY: Bearer token from SpherePay dashboard — server-only — NEVER prefix with NEXT_PUBLIC_
SPHEREPAY_API_KEY=

# ── Fuze Finance ───────────────────────────────────────────────────────────────
# FUZE_API_KEY: API key from Fuze dashboard — server-only — NEVER prefix with NEXT_PUBLIC_
# FUZE_API_SECRET: HMAC signing secret — server-only — NEVER prefix with NEXT_PUBLIC_
# FUZE_API_BASE: optional — default is https://preprod.api.fuze.finance
# FUZE_WEBHOOK_SECRET: optional HMAC secret for /api/fuze/webhook callback verification
FUZE_API_KEY=
FUZE_API_SECRET=
FUZE_API_BASE=
FUZE_WEBHOOK_SECRET=

# ── Doma Protocol ───────────────────────────────────────────────────────────────
# DOMA_ENV: "testnet" or "mainnet" — default mainnet
# DOMA_API_KEY: optional for authenticated Doma APIs such as Poll API and orderbook helpers
# DOMA_API_BASE / DOMA_GRAPHQL_URL: optional overrides for Doma API and Subgraph endpoints
DOMA_ENV=mainnet
DOMA_API_KEY=
DOMA_API_BASE=
DOMA_GRAPHQL_URL=

# ── xStocks (Tokenized Real-World Stocks) ────────────────────────────────────
# XSTOCKS_API_KEY: API key from Backed platform (Settings → API) — server-only — NEVER prefix with NEXT_PUBLIC_
# Public endpoints (assets, proof-of-reserves, oracles, corporate actions) work without an API key.
# Authenticated endpoints (client, xChange RFQ, trades, bridges) require XSTOCKS_API_KEY.
XSTOCKS_API_KEY=

# ── Bitrefill (Gift Cards, eSIMs & Phone Top-Ups) ────────────────────────────
# Powers the Bills tab: 10,000+ gift cards, mobile top-ups, and eSIM data plans
# paid in USDC on Base or Solana. Full guest checkout — no Bitrefill account needed.
#
# Default path (no API key required):
#   Uses @bitrefill/cli guest checkout (v0.3.0+).
#   Anyone can browse products and purchase as a guest — code delivered to email.
#
# Upgrade path (optional — authenticated MCP):
#   Set BITREFILL_API_KEY (or BITREFILL_MCP_URL) to use the authenticated
#   eCommerce MCP endpoint. Unlocks higher-rate-limit access and affiliate tracking.
#   Get your key at https://www.bitrefill.com/account/developers
#
# Guest checkout flow (works without any key):
#   1. Agent calls get_bills to browse the live catalog (country/category/text search)
#   2. Agent calls buy_bitrefill_product with recipientEmail for code delivery
#   3. arcKit sends USDC to the Bitrefill invoice address (Base or Solana)
#   4. Bitrefill delivers the product code to recipientEmail — no account required
#
# ─── Option A — authenticated MCP (optional, higher limits):
# BITREFILL_API_KEY=                      # builds https://api.bitrefill.com/mcp/KEY
# BITREFILL_MCP_URL=                      # or set the full MCP URL directly
BITREFILL_API_KEY=
BITREFILL_MCP_URL=
#
# ─── BITREFILL_CLIENT_ID (recommended for Vercel / serverless) ───────────────
# The OAuth client_id obtained from Bitrefill's Dynamic Client Registration.
# Without this, the server registers a new client on every cold start, which
# quickly hits the 429 rate limit on the registration endpoint.
#
# How to obtain:
#   1. Run locally once (npm run dev) — the server registers and logs the client_id
#   2. Or: curl -s -X POST https://api.bitrefill.com/oauth/mcp/register \
#            -H "Content-Type: application/json" \
#            -d '{"client_name":"bluvfi","grant_types":["client_credentials"],"token_endpoint_auth_method":"none","scope":"mcp"}' \
#          | jq .client_id
# Set the resulting UUID here so Vercel reuses it across all function instances.
BITREFILL_CLIENT_ID=
#
# ─── Affiliate attribution (optional) — earn commission on all purchases:
# Apply at https://www.bitrefill.com/integrate — leave empty if not an affiliate.
# Appended automatically as ?ref=CODE to the MCP URL when using authenticated mode.
BITREFILL_AFFILIATE_CODE=

# ── 0x Protocol (Swap Quotes) ─────────────────────────────────────────────────
# ZERO_X_API_KEY: API key from https://dashboard.0x.org — server-only — NEVER prefix with NEXT_PUBLIC_
# Used by /api/swap-quote to fetch gasless EVM swap quotes across DEX aggregators.
# Free tier available; upgrade for higher rate limits and access to all liquidity sources.
ZERO_X_API_KEY=
